      ));
      _stopSetupService();
      return;
    }

    _log(onLog, '[STEP] Extracting Node.js...');
    onProgress(const SetupState(
      step: SetupStep.installingNode,
      progress: 0.5,
      message: 'Extracting Node.js...',
    ));
